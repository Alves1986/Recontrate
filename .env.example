# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Neon Lakebase Postgres, Auth, Object Storage, Functions, AI Gateway & Realtime
DATABASE_URL="postgresql://user:pass@ep-host-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-host.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"
NEON_BRANCH_ID="br-..."
NEON_FUNCTION_HOST_SUFFIX=".compute.c-8.us-east-2.aws.neon.tech"
NEON_AUTH_BASE_URL="https://ep-host.neonauth.c-8.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-host.neonauth.c-8.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_REALTIME_URL="wss://ep-host.rt.c-8.us-east-2.aws.neon.tech/"
NEON_REALTIME_SECRET="YOUR_NEON_REALTIME_SECRET"
NEON_AI_GATEWAY_BASE_URL="https://br-id-api.ai.c-8.us-east-2.aws.neon.tech"
NEON_AI_GATEWAY_TOKEN="YOUR_NEON_AI_GATEWAY_TOKEN"
AWS_ACCESS_KEY_ID="YOUR_NEON_STORAGE_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_NEON_STORAGE_SECRET_ACCESS_KEY"
AWS_ENDPOINT_URL_S3="https://br-id.storage.c-8.us-east-2.aws.neon.tech"
AWS_REGION="us-east-2"
VITE_NEON_AUTH_URL="$NEON_AUTH_BASE_URL"
VITE_NEON_REALTIME_URL="$NEON_REALTIME_URL"

# Asaas Recurring Billing Gateway
ASAAS_API_URL="https://api.asaas.com/v3"
ASAAS_API_KEY="YOUR_ASAAS_API_KEY"
ASAAS_WEBHOOK_TOKEN="YOUR_ASAAS_WEBHOOK_SECRET"

# Google AdSense / Google Ad Manager (Exclusivo Painel Prestador Gratuito, NPA=1)
VITE_GOOGLE_ADSENSE_CLIENT_ID="ca-pub-0000000000000000"
VITE_GOOGLE_ADSENSE_SLOT_ID="1234567890"
VITE_GOOGLE_ADS_MODE="hibrido_google_adsense"
