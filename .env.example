# ==============================================================================
# Recontrate — Variáveis de Ambiente Obrigatórias e Opcionais (.env.example)
# Copie para .env.local (nunca versionar segredos reais).
# ==============================================================================

# --- Ambiente de Execução ---
NODE_ENV=production
APP_URL=https://seu-dominio.com.br
VITE_APP_URL=https://seu-dominio.com.br
DEMO_MODE=false

# --- Banco de Dados Neon Lakebase PostgreSQL ---
DATABASE_URL=postgresql://usuario:senha@host-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# --- Neon Auth / Realtime / AI Gateway ---
NEON_AUTH_BASE_URL=https://seu-projeto.neonauth.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://seu-projeto.neonauth.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_REALTIME_URL=wss://seu-projeto.rt.aws.neon.tech/
NEON_REALTIME_SECRET=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# --- Armazenamento Privado S3 / Neon Object Storage ---
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Segurança de Sessão JWT (Mínimo 32 caracteres de alta entropia; obrigatório em staging/prod) ---
SESSION_SECRET=substitua-por-segredo-aleatorio-de-no-minimo-32-caracteres

# --- Pagamentos Recorrentes Asaas (Obrigatório para comercialização) ---
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- E-mail Transacional Resend (Obrigatório em staging/prod para verificação e recuperação de senha) ---
RESEND_API_KEY=
EMAIL_FROM="Recontrate <nao-responda@seu-dominio.com.br>"

# --- WhatsApp Business & Geocodificação (Opcional / Recomendado) ---
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GOOGLE_MAPS_API_KEY=

# --- Identidade Jurídica do Controlador & Encarregado DPO (Obrigatório: LGPD / CDC / Decreto 7.962/2013) ---
# ATENÇÃO: Preencher antes do go-live; nunca inventar valores.
VITE_COMPANY_NAME=
VITE_COMPANY_CNPJ=
VITE_COMPANY_ADDRESS=
VITE_DPO_NAME=
VITE_DPO_EMAIL=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_HOURS="Segunda a sexta-feira, das 9h às 18h (horário de Brasília)"

# --- Publicidade Contextual / Anúncios (Opcional — somente após consentimento ANPD de cookies) ---
VITE_GOOGLE_ADS_MODE=adsense_live
VITE_GOOGLE_ADSENSE_CLIENT_ID=
VITE_GOOGLE_ADSENSE_SLOT_ID=
